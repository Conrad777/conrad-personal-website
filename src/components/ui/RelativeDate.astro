---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"time"> {
  date: string;
  addSuffix?: boolean;
}

const { date, addSuffix, ...props } = Astro.props;

const absoluteDate = new Date(date).toLocaleDateString("en", {
  dateStyle: "medium",
});
---

<script>
  import { formatRelativeDate } from "./relative-date.util";

  document
    .querySelectorAll<HTMLTimeElement>("time[data-relative-date]")
    .forEach((el) => {
      el.textContent = formatRelativeDate(el.dateTime, {
        addSuffix: el.dataset.addSuffix === "true",
      });
    });
</script>

<time
  datetime={date}
  data-relative-date
  data-add-suffix={String(addSuffix)}
  set:text={absoluteDate}
  {...props}
/>
